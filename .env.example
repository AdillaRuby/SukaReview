# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google Business Profile (Phase 4-5, optional until you go live) ───────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=
# Required for /api/google/pubsub to accept requests (it rejects everything
# if this is unset). Shared secret appended as ?token=... to your Pub/Sub
# push endpoint URL.
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# demo = realistic seed/mock data, no Google credentials required.
# live = real Google Business Profile integration (requires everything above).
GOOGLE_MODE=demo

# Symmetric key used to encrypt Google OAuth tokens at rest in
# google_connections. Generate one with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Shows the "Simulate New Review" dev button even when NODE_ENV=production,
# as long as GOOGLE_MODE=demo. Leave unset for normal production deploys.
NEXT_PUBLIC_SHOW_DEV_SIMULATOR=false

# ── Gemini (Phase 3, optional — falls back to analysis_status=pending) ────
GEMINI_API_KEY=

# ── Places API review sync (independent of GOOGLE_MODE, no OAuth needed) ──
# api (default) = official Places API, requires GOOGLE_PLACES_API_KEY and
# Google Cloud billing. scrape = Puppeteer-based Google Maps scraping, no
# API key or billing needed — see docs/superpowers/specs/2026-09-01-google-maps-scraper-design.md
# for the trade-offs (ToS risk, fragility, blocking risk) before using this.
GOOGLE_PLACES_MODE=api

# https://console.cloud.google.com — enable "Places API (New)", create a key.
GOOGLE_PLACES_API_KEY=

# Only needed when GOOGLE_PLACES_MODE=scrape and running locally (not on
# Vercel, which uses @sparticuz/chromium automatically). Point this at your
# installed Chrome, e.g. on Windows:
# C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=

# MUST be named exactly CRON_SECRET — Vercel only auto-attaches the
# Authorization header to cron requests for an env var with this literal
# name. Generate with: openssl rand -hex 24
CRON_SECRET=
